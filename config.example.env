# Gmail SMTP. Keep actual addresses and the Gmail App Password in .env locally
# or GitHub Actions Secrets; never commit them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
EMAIL_TO=your-receiving-address

# false: blue EMA23 channel is above yellow EMA89 channel (default).
# true: require the stricter blue lower-bound > yellow upper-bound condition.
STRICT_BLUE_ABOVE=false
MAX_WORKERS=6
